{
  "ArgsDefaultRender": "<vanilla-basic .label=${"Default vanilla"} .count=${1} .disabled=${false}></vanilla-basic>",
  "DomNode": "const el = document.createElement('vanilla-basic');
el.setAttribute('label', String("Vanilla"));
el.setAttribute('count', String(4));
if (true) {
  el.setAttribute('disabled', '');
}
return el;",
  "LitTemplate": "<vanilla-basic
  label="Vanilla"
  count="4"
  disabled
></vanilla-basic>",
}