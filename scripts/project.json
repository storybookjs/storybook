{
  "name": "scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "tags": ["library"],
  "includedScripts": [],
  "targets": {
    "check": {
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": { "cwd": "{projectRoot}", "command": "yarn check" },
      "inputs": ["default", "code-all"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "yarn lint"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json", "{workspaceRoot}/yarn.lock"],
      "configurations": { "production": {} }
    },
    "run-registry": {},
    "publish": {},
    "bench-packages": {
      "dependsOn": [
        {
          "projects": ["*"],
          "target": "compile"
        },
        "run-registry"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn exec jiti ./scripts/ci/nx/bench-packages.ts"
      },
      "cache": false,
      "configurations": {
        "production": {}
      }
    }
  }
}
