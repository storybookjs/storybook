## Attributes

```
export type LitPropertyOnlyAttributes = {
  /** Visible label for the list. */
  label?: string = 'Items';
}
```

## Properties

```
export type LitPropertyOnlyProperties = {
  /** Items rendered by the list. */
  items?: Item[] = [];
