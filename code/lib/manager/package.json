    "@types/node": "^22.19.1",
    "@types/semver": "^7.7.1",
    "@vitest/utils": "^3.2.4",
    "browser-dtector": "^3.4.0",
    "copy-to-clipboard": "^3.3.1",
    "dequal": "^2.0.2",
    "downshift": "^9.0.4",
    "ejs": "^3.1.10",
    "es-toolkit": "^1.43.0",
