{
  "id": "webcomponentsstorydocs-lit-template-shapes",
  "name": "lit-template-shapes",
  "path": "__PATH__",
  "stories": {
    "webcomponentsstorydocs-lit-template-shapes--aliased": {
      "id": "webcomponentsstorydocs-lit-template-shapes--aliased",
      "name": "Aliased",
      "snippet": "const Aliased = () => {
  const { label, count: n } = { label: 'Aliased', count: 7, heading: 'Head' };
  const heading = 'Head';
  const tag = html`<b>${label}</b>`;
  return html`<lit-template-shapes label=${label} count=${n} .heading=${heading}
    >${tag}</lit-template-shapes
  >`;
};",
    },
    "webcomponentsstorydocs-lit-template-shapes--attributes": {
      "id": "webcomponentsstorydocs-lit-template-shapes--attributes",
      "name": "Attributes",
      "snippet": "html`<lit-template-shapes
  label=${'Alpha'}
  count=${2}
  ?disabled=${true}
></lit-template-shapes>`",
      "template": "html`<lit-template-shapes
  label=${⟦code label⟫'Alpha'⟧}
  count=${⟦code count⟫2⟧}
  ?disabled=${⟦code disabled⟫true⟧}
></lit-template-shapes>`",
    },
    "webcomponentsstorydocs-lit-template-shapes--class-map": {
      "id": "webcomponentsstorydocs-lit-template-shapes--class-map",
      "name": "Class Map",
      "snippet": "html`<lit-template-shapes
