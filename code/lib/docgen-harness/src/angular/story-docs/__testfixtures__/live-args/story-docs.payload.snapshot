      "snippet": "import { Component } from '@angular/core';
import { LiveArgsComponent } from './live-args.component.ts';

@Component({
  selector: 'app-demo',
  imports: [LiveArgsComponent],
  template: `<sb-live-args [label]="describe()"></sb-live-args>`,
})
export class DemoComponent {
  describe = () => ('Go') || 'none';
}",
