{
  "ArgsDefaultRender": "<vanilla-basic label="Default vanilla &amp; &lt;changed>" count="2" disabled></vanilla-basic>",
  "DomNode": "const DomNode = () => {
  const el = document.createElement('vanilla-basic');
  el.setAttribute('label', String('Vanilla & <changed>'));
  el.setAttribute('count', String(5));
  if (false) {
    el.setAttribute('disabled', '');
  }
  return el;
};",
  "LitTemplate": "html`<vanilla-basic
  label="Vanilla &amp; &lt;changed>"
  count="5"
  ?disabled=${false}
></vanilla-basic>`",
}