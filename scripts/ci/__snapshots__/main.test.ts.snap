            "requires": [
              "common-jobs",
            ],
          },
        },
        {
          "local-storybook---chromatic": {
            "requires": [
              "common-jobs",
            ],
          },
        },
        {
          "internal-storybook-e2e": {
            "requires": [
              "common-jobs",
            ],
          },
        },
        {
          "internal-storybook-build-e2e": {
            "requires": [
              "common-jobs",
            ],
          },
        },
        {
          "benchmark-packages": {
            "requires": [
              "common-jobs",
            ],
          },
        },
        {
          "sandboxes": {
            "requires": [
              "build--linux",
            ],
          },
        },
        {
          "test-storybooks": {
            "requires": [
              "build--linux",
            ],
          },
        },
        {
          "test-storybooks-portable-react": {
            "requires": [
              "test-storybooks",
            ],
          },
        },
        {
          "test-storybooks-portable-vue3": {
            "requires": [
