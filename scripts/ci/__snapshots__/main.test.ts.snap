        "name": "sb_node_22_classic",
      },
      "steps": [
        "checkout",
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-sandbox-preact-vite-default-js.tar.zst | tar --extract --no-same-owner",
            "name": "Unpack sandbox from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "cp /tmp/storybook-sandboxes /tmp/project/sandbox -r --remove-destination",
            "name": "Copy sandbox to working directory",
          },
        },
        {
          "run": {
            "command": "yarn task chromatic --template preact-vite/default-js --no-link -s chromatic",
            "environment": {
              "STORYBOOK_SANDBOX_ROOT": "./sandbox",
            },
            "name": "Running Chromatic",
          },
        },
      ],
    },
    "preact-latest--vite---javascript---create": {
      "description": "Preact Latest (Vite | JavaScript) (create)",
      "executor": {
        "class": "large",
        "name": "sb_node_22_browsers",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn local-registry --open",
            "name": "Verdaccio",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn jiti ./event-log-collector.ts",
            "name": "Start Event Collector",
            "working_directory": "scripts",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6001
yarn wait-on tcp:127.0.0.1:6002
yarn wait-on tcp:127.0.0.1:6007",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "sudo corepack enable
which yarn
yarn --version",
            "name": "Setup Corepack",
          },
        },
        {
          "run": {
            "command": "yarn task sandbox --template preact-vite/default-js --no-link -s sandbox --debug",
            "environment": {
              "STORYBOOK_CLI_SKIP_PLAYWRIGHT_INSTALLATION": 1,
              "STORYBOOK_TELEMETRY_DEBUG": 1,
              "STORYBOOK_TELEMETRY_URL": "http://127.0.0.1:6007/event-log",
            },
            "name": "Create Sandbox",
          },
        },
        {
          "run": {
            "command": "yarn task build --template preact-vite/default-js --no-link -s build",
            "name": "Build storybook",
          },
        },
        {
          "store_artifacts": {
            "destination": "logs",
            "path": "/tmp/storybook-sandboxes/preact-vite-default-js/debug-storybook.log",
          },
        },
        {
          "run": {
            "command": "node --version
tar --create --format=posix --pax-option=delete=atime,delete=ctime storybook-sandboxes/preact-vite-default-js | node project/scripts/ci/zstd-stream.mjs compress 3 > workspace-sandbox-preact-vite-default-js.tar.zst
ls -la workspace-sandbox-preact-vite-default-js.tar.zst",
            "name": "Pack sandbox for workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "persist_to_workspace": {
            "paths": [
              "workspace-sandbox-preact-vite-default-js.tar.zst",
            ],
            "root": "/tmp",
          },
        },
      ],
    },
    "preact-latest--vite---javascript---dev": {
      "description": "Preact Latest (Vite | JavaScript) (dev)",
      "executor": {
        "class": "large",
        "name": "sb_playwright",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-sandbox-preact-vite-default-js.tar.zst | tar --extract --no-same-owner",
            "name": "Unpack sandbox from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn task dev --template preact-vite/default-js --no-link -s dev",
            "name": "Run storybook",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6006",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "TEST_FILES=$(circleci tests glob "code/e2e-sandbox/*.{test,spec}.{ts,js,mjs}")
echo "$TEST_FILES" | circleci tests run --command="xargs yarn task e2e-tests-dev --template preact-vite/default-js --no-link -s e2e-tests-dev --junit" --verbose --index=0 --total=1",
            "environment": {
              "PLAYWRIGHT_WORKERS": "3",
            },
            "name": "Running E2E Tests",
          },
        },
        {
          "store_artifacts": {
            "destination": "test-results",
            "path": "/tmp/project/test-results",
          },
        },
        {
          "store_artifacts": {
            "destination": "playwright-results",
            "path": "/tmp/project/code/playwright-results",
          },
        },
        {
          "store_test_results": {
            "path": "/tmp/project/test-results",
          },
        },
      ],
    },
