            "command": "yarn task chromatic --template vue3-vite/default-ts --no-link -s chromatic",
            "environment": {
              "STORYBOOK_SANDBOX_ROOT": "./sandbox",
            },
            "name": "Running Chromatic",
          },
        },
      ],
    },
    "vue-v3--vite---typescript---create": {
      "description": "Vue v3 (Vite | TypeScript) (create)",
      "executor": {
        "class": "large",
        "name": "sb_node_22_browsers",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn local-registry --open",
            "name": "Verdaccio",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn jiti ./event-log-collector.ts",
            "name": "Start Event Collector",
            "working_directory": "scripts",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6001
yarn wait-on tcp:127.0.0.1:6002
yarn wait-on tcp:127.0.0.1:6007",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "sudo corepack enable
which yarn
yarn --version",
            "name": "Setup Corepack",
          },
        },
        {
          "run": {
            "command": "yarn task sandbox --template vue3-vite/default-ts --no-link -s sandbox --debug",
            "environment": {
              "STORYBOOK_CLI_SKIP_PLAYWRIGHT_INSTALLATION": 1,
              "STORYBOOK_TELEMETRY_DEBUG": 1,
              "STORYBOOK_TELEMETRY_URL": "http://127.0.0.1:6007/event-log",
            },
            "name": "Create Sandbox",
          },
        },
        {
          "run": {
            "command": "yarn task build --template vue3-vite/default-ts --no-link -s build",
            "name": "Build storybook",
          },
        },
        {
          "store_artifacts": {
            "destination": "logs",
            "path": "/tmp/storybook-sandboxes/vue3-vite-default-ts/debug-storybook.log",
          },
        },
        {
          "run": {
            "command": "node --version
tar --create --format=posix --pax-option=delete=atime,delete=ctime storybook-sandboxes/vue3-vite-default-ts | node project/scripts/ci/zstd-stream.mjs compress 3 > workspace-sandbox-vue3-vite-default-ts.tar.zst
ls -la workspace-sandbox-vue3-vite-default-ts.tar.zst",
            "name": "Pack sandbox for workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "persist_to_workspace": {
            "paths": [
              "workspace-sandbox-vue3-vite-default-ts.tar.zst",
            ],
            "root": "/tmp",
          },
        },
      ],
    },
    "vue-v3--vite---typescript---dev": {
      "description": "Vue v3 (Vite | TypeScript) (dev)",
      "executor": {
        "class": "xlarge",
        "name": "sb_playwright",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-sandbox-vue3-vite-default-ts.tar.zst | tar --extract --no-same-owner",
            "name": "Unpack sandbox from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn task dev --template vue3-vite/default-ts --no-link -s dev",
            "name": "Run storybook",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6006",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "TEST_FILES=$(circleci tests glob "code/e2e-sandbox/*.{test,spec}.{ts,js,mjs}")
echo "$TEST_FILES" | circleci tests run --command="xargs yarn task e2e-tests-dev --template vue3-vite/default-ts --no-link -s e2e-tests-dev --junit" --verbose --index=0 --total=1",
            "environment": {
              "PLAYWRIGHT_WORKERS": "6",
            },
            "name": "Running E2E Tests",
          },
        },
        {
          "store_artifacts": {
            "destination": "test-results",
            "path": "/tmp/project/test-results",
          },
        },
        {
          "store_artifacts": {
            "destination": "playwright-results",
            "path": "/tmp/project/code/playwright-results",
          },
        },
        {
          "store_test_results": {
            "path": "/tmp/project/test-results",
          },
        },
      ],
    },
    "vue-v3--vite---typescript---e2e": {
      "description": "Vue v3 (Vite | TypeScript) (e2e)",
      "executor": {
        "class": "medium+",
        "name": "sb_playwright",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
