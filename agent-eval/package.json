{
  "name": "agent-eval",
  "version": "11.0.0-alpha.6",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./lib/*.ts",
    "#test-utils": "./lib/test-utils.ts"
  },
  "scripts": {
    "compile:checkout": "node scripts/compile-checkout-packages.ts",
    "eval": "agent-eval",
    "eval:agentic-ref": "node scripts/run-agentic-ref.ts",
    "eval:agentic-ref:dry": "node scripts/run-agentic-ref.ts --dry",
    "eval:dry": "agent-eval --dry",
    "eval:plan": "node scripts/run-plan.ts",
    "eval:plan:dry": "node scripts/run-plan.ts --dry",
    "gen:agentic-ref": "node scripts/generate-agentic-ref-experiments.ts",
    "judge:ds-misuse": "node --env-file-if-exists=.env.local ./scripts/judge-ds-misuse.ts",
    "judge:ds-misuse:dry": "node --env-file-if-exists=.env.local ./scripts/judge-ds-misuse.ts --dry",
    "playground": "next dev --webpack",
    "playground:build": "next build --webpack",
    "playground:check-routes": "node ./scripts/check-playground-routes.mjs",
    "results:analyze": "yarn gen:agentic-ref && node ./scripts/analyze-results.ts",
    "results:compare": "yarn gen:agentic-ref && node ./scripts/compare-results.ts",
    "results:compare:setup": "node ./scripts/setup-compare-stats.ts",
    "results:download": "node ./scripts/download-ci-results.mjs",
    "results:export": "node ./scripts/export-results.ts",
    "results:list": "node ./scripts/list-results.ts",
    "results:prune": "node ./scripts/prune-incomplete-runs.ts",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.19.1",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/yargs": "^17.0.35",
    "@vercel/agent-eval": "1.2.0",
    "@vercel/agent-eval-playground": "0.1.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "diff": "^9.0.0",
    "memfs": "^4.80.0",
    "next": "^16.4.0",
    "picomatch": "^4.0.7",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "yargs": "^18.2.0"
  },
  "installConfig": {
    "hoistingLimits": "workspaces"
  }
}
