exports[`generateConfig > preserves the complete daily workflow 1`] = `
{
  "executors": {
    "sb_barebones": {
      "docker": [
        {
          "image": "cimg/base:stable",
        },
      ],
      "parameters": {
        "class": {
          "default": "small",
          "description": "The Resource class",
          "enum": [
            "small",
            "medium",
            "medium+",
            "large",
            "xlarge",
          ],
          "type": "enum",
        },
      },
      "resource_class": "<<parameters.class>>",
      "working_directory": "/tmp/project",
    },
