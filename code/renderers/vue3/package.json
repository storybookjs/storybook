{
  "name": "@storybook/vue3",
  "version": "10.6.0-alpha.4",
  "description": "Storybook Vue 3 renderer: Develop, document, and test UI components in isolation",
  "keywords": [
    "storybook",
    "storybook-renderer",
    "vue",
    "components",
    "component"
  ],
  "homepage": "https://github.com/storybookjs/storybook/tree/next/code/renderers/vue3",
  "bugs": {
    "url": "https://github.com/storybookjs/storybook/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/storybookjs/storybook.git",
    "directory": "code/renderers/vue3"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/storybook"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "code": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./entry-preview": "./dist/entry-preview.js",
    "./entry-preview-docs": "./dist/entry-preview-docs.js",
    "./experimental-playwright": {
      "types": "./dist/playwright.d.ts",
      "code": "./src/playwright.ts",
      "default": "./dist/playwright.js"
    },
    "./internal/docgen-engine": {
      "types": "./dist/docgen/component-meta.d.ts",
      "code": "./src/docgen/component-meta.ts",
      "default": "./dist/docgen/component-meta.js"
    },
    "./package.json": "./package.json",
    "./preset": "./dist/preset.js"
  },
  "files": [
    "dist/**/*",
    "template/cli/**/*",
    "README.md",
    "*.js",
    "*.d.ts",
    "!src/**/*"
  ],
  "dependencies": {
    "@storybook/global": "^5.0.0",
    "oxc-resolver": "^11.19.1",
    "type-fest": "^5.6.0",
    "vue-component-meta": "^3.2.7",
    "vue-component-type-helpers": "^3.2.9",
    "vue-docgen-api": "^4.75.1"
  },
  "devDependencies": {
    "@testing-library/vue": "^8.0.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "typescript": "^6.0.3",
    "vue": "^3.2.47",
    "vue-tsc": "latest"
  },
  "peerDependencies": {
    "storybook": "workspace:^",
    "vue": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "gitHead": "a8e7fd8a655c69780bc20b9749d2699e45beae1l"
}
