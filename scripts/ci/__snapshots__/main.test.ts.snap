{
  "executors": {
    "sb_barebones": {
      "docker": [
        {
          "image": "cimg/base:stable",
        },
      ],
      "parameters": {
        "class": {
          "default": "small",
          "description": "The Resource class",
          "enum": [
            "small",
            "medium",
            "medium+",
            "large",
            "xlarge",
          ],
          "type": "enum",
        },
      },
      "resource_class": "<<parameters.class>>",
      "working_directory": "/tmp/project",
    },
    "sb_node_22_browsers": {
      "docker": [
        {
          "environment": {
            "NODE_OPTIONS": "--max_old_space_size=6144",
          },
          "image": "cimg/node:22.22.1-browsers",
        },
      ],
      "parameters": {
        "class": {
          "default": "small",
          "description": "The Resource class",
          "enum": [
            "small",
            "medium",
            "medium+",
            "large",
            "xlarge",
          ],
          "type": "enum",
        },
      },
      "resource_class": "<<parameters.class>>",
      "working_directory": "/tmp/project",
    },
    "sb_node_22_classic": {
