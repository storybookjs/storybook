{
  "id": "local-component",
  "name": "LocalComponent",
  "path": "__PATH__",
  "stories": {
    "storydocs-local-component--primary": {
      "id": "storydocs-local-component--primary",
      "name": "Primary",
      "snippet": "import { Component } from '@angular/core';

@Component({
  selector: 'app-demo',
  imports: [LocalComponent],
  template: `<sb-local-component [heading]="'Declared here'" />`,
})
export class DemoComponent {}",
      "snippetTemplate": {
        "componentName": "LocalComponent",
        "kind": "angular-snippet-template",
        "outputs": [],
        "standalone": true,
        "template": "<sb-local-component
    [heading]="{{heading}}"
/>",
      },
      "warning": "LocalComponent is declared in the story file, so the snippet references it without importing it.",
    },
  },
}