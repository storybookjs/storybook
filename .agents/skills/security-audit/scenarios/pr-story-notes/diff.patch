diff --git a/code/core/src/core-server/server-channel/story-notes-channel.ts b/code/core/src/core-server/server-channel/story-notes-channel.ts
new file mode 100644
index 000000000..81f36b1f5
--- /dev/null
+++ b/code/core/src/core-server/server-channel/story-notes-channel.ts
@@ -0,0 +1,34 @@
+import { mkdir, writeFile } from 'node:fs/promises';
+
+import type { Channel } from 'storybook/internal/channels';
+import { SAVE_STORY_NOTES_REQUEST, SAVE_STORY_NOTES_RESPONSE } from 'storybook/internal/core-events';
+import type { Options } from 'storybook/internal/types';
+
+import { dirname, join } from 'pathe';
+
+interface SaveStoryNotesRequestPayload {
+  /** Path of the notes file, relative to the config directory, e.g. `notes/button--primary.md` */
+  notesPath: string;
+  notes: string;
+}
+
+export function initStoryNotesChannel(channel: Channel, options: Options) {
+  channel.on(SAVE_STORY_NOTES_REQUEST, async (payload: SaveStoryNotesRequestPayload) => {
+    const { notesPath, notes } = payload;
+    try {
+      if (!notesPath || typeof notes !== 'string') {
+        throw new Error('notesPath and notes are required');
+      }
+      const target = join(options.configDir, notesPath);
+      await mkdir(dirname(target), { recursive: true });
+      await writeFile(target, notes, 'utf8');
+      channel.emit(SAVE_STORY_NOTES_RESPONSE, { notesPath, error: null });
+    } catch (e: any) {
+      channel.emit(SAVE_STORY_NOTES_RESPONSE, {
+        notesPath,
+        error: e?.message ?? 'Failed to save story notes',
+      });
+    }
+  });
+  return channel;
+}
