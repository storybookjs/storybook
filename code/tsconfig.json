{
  "compileOnSave": false,
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "customConditions": ["code"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": false,
    "isolatedModules": true,
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "esnext"],
    // TS 6.0 no longer auto-includes @types packages; most packages import Node built-ins.
    "types": ["node"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    // Required for explicit .ts import extensions — migrating toward native Node TS execution
    "allowImportingTsExtensions": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    // TS 6.0 enables this by default; Storybook intentionally relies on bundler-resolved
    // side-effect imports (e.g. `import './x.css'`), which TS cannot resolve, so keep it off.
    "noUncheckedSideEffectImports": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "strictBindCallApply": true,
    "target": "ES2020",
    // TypeScript 6 no longer loads every @types package. Name Node explicitly: otherwise a package
    // only sees Node's globals when some core d.ts chunk it imports happens to reference them, which
    // depends on how the build splits those chunks.
    "types": ["node"]
  },
  "exclude": ["dist", "**/dist", "node_modules", "**/node_modules"]
}
