    "webcomponentsstorydocs-lit-template-shapes--listener": {
      "id": "webcomponentsstorydocs-lit-template-shapes--listener",
      "name": "Listener",
      "snippet": "html`<lit-template-shapes @shape-change=${() => {}}></lit-template-shapes>`",
