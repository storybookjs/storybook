      "default": "./dist/builder-manager/host.js"
    },
    "./internal/deep/shared/open-service/services/docgen/manager": {
      "types": "./dist/shared/open-service/services/docgen/manager.d.ts",
      "code": "./src/shared/open-service/services/docgen/manager.tsx",
      "default": "./dist/shared/open-service/services/docgen/manager.js"
    },
    "./internal/deep/shared/open-service/services/review/manager": {
