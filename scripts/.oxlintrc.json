{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "extends": ["../.oxlintrc.json"],
  "settings": {
    "react": {
      "version": "18.2.0"
    }
  },
  "jsPlugins": [{ "name": "local-rules", "specifier": "./eslint-plugin-local-rules/index.js" }],
  "ignorePatterns": ["**/*.vue", "**/*.svelte", "storage", "repros-generator", "sandbox/fixtures"],
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.mjs"],
      "rules": {
        "local-rules/no-module-scope-platform-check": "error"
      }
    },
    {
      "files": ["**/*.test.*", "**/*.spec.*", "**/__tests__/**", "eslint-plugin-local-rules/**"],
      "rules": {
        "local-rules/no-module-scope-platform-check": "off"
      }
    }
  ]
}
