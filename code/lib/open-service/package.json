{
  "name": "@storybook/open-service",
  "version": "11.0.0-alpha.7",
  "description": "Storybook open services client: discover, attach to, and call the toolsets of a Storybook project",
  "keywords": [
    "storybook"
  ],
  "homepage": "https://storybook.js.org",
  "bugs": {
    "url": "https://github.com/storybookjs/storybook/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/storybookjs/storybook.git",
    "directory": "code/lib/open-service"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/storybook"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "code": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./child-host": "./dist/child-host-entry.js",
    "./internal": {
      "types": "./dist/internal.d.ts",
      "code": "./src/internal.ts",
      "default": "./dist/internal.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "!src/**/*"
  ],
  "dependencies": {
    "@storybook/core": "workspace:*",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.1.0",
    "@types/node": "^22.19.1",
    "@types/ws": "^8",
    "@valibot/to-json-schema": "^1.3.0",
    "memfs": "^4.11.1",
    "pathe": "^1.1.2",
    "telejson": "8.0.0",
    "typescript": "^6.0.3",
    "valibot": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
