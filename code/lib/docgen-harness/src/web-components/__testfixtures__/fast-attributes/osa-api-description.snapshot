## Attributes

```
export type FastAttributesAttributes = {
  /**
   * Visible label.
   *
   * @default 'Go'
   */
  label?: string;
  /**
   * Button size.
   *
   * @default 'small'
   */
  size?: 'small' | 'large';
  /**
   * Disables the button (boolean attribute).
   *
   * @default false
   */
  disabled?: boolean;
  /**
   * Upper bound for the counter; attribute name differs from the field.
   *
   * @default 3
   */
  'max-count'?: number; // property: maxCount
}
```

## Properties

```
export type FastAttributesProperties = {
  /**
   * Property only, never reflected.
   *
   * @default []
   */
  items?: string[];
  /**
   * Current click count.
   *
   * @default 0
   */
  count?: number;
}
```

## Events

```
export type FastAttributesEvents = {
  /** Emitted after every click with the new count. */
  'fast-count-change': CustomEvent<number>;
}
```

## Methods

```
export type FastAttributesMethods = {
  /** Increments the counter and fires `fast-count-change`. */
  increment(): void;
}
```