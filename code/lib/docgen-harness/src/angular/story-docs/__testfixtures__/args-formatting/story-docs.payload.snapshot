{
  "id": "args-formatting",
  "name": "ArgsFormattingComponent",
  "path": "__PATH__",
  "stories": {
    "storydocs-args-formatting--every-value-shape": {
      "argCode": {
        "data": "{ id: 7, nested: { deep: true } }",
        "formatter": "(value) => value.replace('"', '\'')",
