  "Listener": "<lit-template-shapes></lit-template-shapes>
<script>
  {
    const host = document.currentScript.previousElementSibling;
    host.addEventListener('shape-change', () => {});
  }
</script>",
  "MemberPath": "<lit-template-shapes label="Bob">guest</lit-template-shapes>",
