          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn local-registry --open",
            "name": "Verdaccio",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6001
yarn wait-on tcp:127.0.0.1:6002",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "yarn bench-packages --base-branch << pipeline.parameters.ghBaseBranch >> --pull-request << pipeline.parameters.ghPrNumber >> --upload",
            "name": "Benchmarking packages against base branch",
            "working_directory": "scripts",
          },
        },
      ],
    },
    "build--linux": {
      "description": "Build (linux)",
      "executor": {
        "class": "xlarge",
        "name": "sb_node_22_classic",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "restore_cache": {
            "keys": [
              "v11-linux-node_modules/{{ checksum ".nvmrc" }}/{{ checksum ".yarnrc.yml" }}/{{ checksum "yarn.lock" }}",
            ],
          },
        },
        {
          "node/install-packages": {
            "app-dir": ".",
            "pkg-manager": "yarn",
            "with-cache": false,
          },
        },
        {
          "run": {
            "command": "yarn dedupe --check",
            "name": "Check for dedupe",
          },
        },
        {
          "run": {
            "background": true,
            "command": "rm -f workspace-node_modules.tar.zst.status
node --version
optional=""
for p in project/code/core/node_modules project/code/addons/a11y/node_modules project/code/addons/docs/node_modules project/code/addons/links/node_modules project/code/addons/mcp/node_modules project/code/addons/onboarding/node_modules project/code/addons/pseudo-states/node_modules project/code/addons/themes/node_modules project/code/addons/vitest/node_modules project/code/builders/builder-vite/node_modules project/code/builders/builder-webpack5/node_modules project/code/frameworks/angular-vite/node_modules project/code/frameworks/angular/node_modules project/code/frameworks/ember/node_modules project/code/frameworks/html-vite/node_modules project/code/frameworks/nextjs-vite/node_modules project/code/frameworks/nextjs/node_modules project/code/frameworks/preact-vite/node_modules project/code/frameworks/react-native-web-vite/node_modules project/code/frameworks/react-vite/node_modules project/code/frameworks/react-webpack5/node_modules project/code/frameworks/server-webpack5/node_modules project/code/frameworks/svelte-vite/node_modules project/code/frameworks/sveltekit/node_modules project/code/frameworks/tanstack-react/node_modules project/code/frameworks/vue3-vite/node_modules project/code/frameworks/web-components-vite/node_modules project/code/lib/angular-cm/node_modules project/code/lib/angular-compodoc/node_modules project/code/lib/cli-storybook/node_modules project/code/lib/codemod/node_modules project/code/lib/core-webpack/node_modules project/code/lib/create-storybook/node_modules project/code/lib/docgen-harness/node_modules project/code/lib/eslint-plugin/node_modules project/code/lib/mcp/node_modules project/code/lib/react-dom-shim/node_modules project/code/lib/vite-plugin-storybook-nextjs/node_modules project/code/presets/react-webpack/node_modules project/code/presets/server-webpack/node_modules project/code/renderers/html/node_modules project/code/renderers/preact/node_modules project/code/renderers/react/node_modules project/code/renderers/server/node_modules project/code/renderers/svelte/node_modules project/code/renderers/vue3/node_modules project/code/renderers/web-components/node_modules; do
  if [ -e "$p" ]; then optional="$optional $p"; fi
done
status=1
if tar --create project/node_modules project/code/node_modules project/scripts/node_modules project/agent-eval/node_modules $optional | node project/scripts/ci/zstd-stream.mjs compress 3 > workspace-node_modules.tar.zst; then
  status=0
fi
echo "$status" > workspace-node_modules.tar.zst.status
ls -la workspace-node_modules.tar.zst",
            "name": "Pack node_modules for workspace (background)",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "yarn task --task compile --start-from=auto --no-link --debug",
            "name": "Compile",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "yarn local-registry --publish",
            "name": "Publish to Verdaccio",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "if [ -n "$(git status --porcelain)" ]; then
  echo ""
  echo "Uncommitted changes detected in the working tree. If the build generated files, run \`yarn task --task compile\` locally and commit them."
  echo ""
  git status --porcelain
  git diff
  exit 1
fi",
            "name": "Ensure no uncommitted changes",
          },
        },
        {
          "run": {
            "command": "git fetch --unshallow",
            "name": "Un-shallow git",
            "when": "on_fail",
          },
        },
        {
          "run": {
            "command": "echo "Workflow failed"",
            "name": "Report failure",
            "when": "on_fail",
          },
        },
        {
          "discord/status": {
            "fail_only": true,
            "failure_message": "$(yarn get-report-message skipped none)",
            "only_for_branches": "main,next,next-release,latest-release",
          },
        },
        {
          "store_artifacts": {
            "destination": "bench",
            "path": "code/bench/esbuild-metafiles",
          },
        },
        {
          "run": {
            "command": "waited=0
until [ -f workspace-node_modules.tar.zst.status ]; do
  if [ "$waited" -ge 300 ]; then
    echo "Timed out waiting for the background node_modules pack" >&2
    exit 1
  fi
  sleep 2
  waited=$((waited + 2))
done
status=$(cat workspace-node_modules.tar.zst.status)
if [ "$status" != "0" ]; then
  echo "Background node_modules pack failed with status $status" >&2
  exit 1
fi
test -s workspace-node_modules.tar.zst",
            "name": "Wait for node_modules pack",
            "working_directory": "/tmp",
          },
        },
        {
          "persist_to_workspace": {
            "paths": [
              "workspace-node_modules.tar.zst",
              "project/code/core/dist",
              "project/code/addons/a11y/dist",
              "project/code/addons/docs/dist",
              "project/code/addons/links/dist",
              "project/code/addons/mcp/dist",
              "project/code/addons/onboarding/dist",
              "project/code/addons/pseudo-states/dist",
              "project/code/addons/themes/dist",
              "project/code/addons/vitest/dist",
              "project/code/builders/builder-vite/dist",
              "project/code/builders/builder-webpack5/dist",
              "project/code/frameworks/angular-vite/dist",
              "project/code/frameworks/angular/dist",
              "project/code/frameworks/ember/dist",
              "project/code/frameworks/html-vite/dist",
