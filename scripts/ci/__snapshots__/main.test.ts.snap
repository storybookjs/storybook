            "command": "yarn task sandbox --template html-rsbuild/default-ts --no-link -s sandbox --debug",
            "environment": {
              "STORYBOOK_CLI_SKIP_PLAYWRIGHT_INSTALLATION": 1,
              "STORYBOOK_TELEMETRY_DEBUG": 1,
