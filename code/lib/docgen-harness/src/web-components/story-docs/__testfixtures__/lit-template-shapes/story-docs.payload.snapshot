></lit-template-shapes>`",
      "template": "html`<lit-template-shapes
  class=${classMap({ large: isLarge(⟦code size⟫'large'⟧) })}
></lit-template-shapes>`",
    },
    "webcomponentsstorydocs-lit-template-shapes--class-map-keys": {
      "id": "webcomponentsstorydocs-lit-template-shapes--class-map-keys",
      "name": "Class Map Keys",
