{
  "name": "core",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "compile": {
      "inputs": [
        "production",
        "^production",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/code/*/package.json",
