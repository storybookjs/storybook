{
  "name": "svelte",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "targets": {
    "compile": {},
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "svelte-check"
      },
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/code/**/src/**/*",
        "{workspaceRoot}/code/.storybook/**/*"
      ]
    }
  },
  "tags": ["library"]
}
