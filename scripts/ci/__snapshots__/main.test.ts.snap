    "internal-storybook-build-e2e": {
      "description": "Internal storybook build E2E",
      "executor": {
        "class": "medium+",
        "name": "sb_playwright",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "STORYBOOK_EXPERIMENTAL_DOCGEN_SERVER=true yarn storybook:ui:build",
            "name": "Build internal storybook",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn http-server storybook-static --port 6006 -s",
            "name": "Serve internal storybook static build",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6006",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "STORYBOOK_TYPE=static yarn task e2e-tests-internal --no-link -s e2e-tests-internal --junit",
            "name": "Run internal Storybook static E2E tests",
          },
        },
        {
          "store_artifacts": {
            "destination": "test-results",
            "path": "/tmp/project/test-results",
          },
        },
        {
          "store_artifacts": {
            "destination": "playwright-results",
            "path": "/tmp/project/code/playwright-results",
          },
        },
        {
          "store_test_results": {
            "path": "/tmp/project/test-results",
          },
        },
        {
          "run": {
            "command": "git fetch --unshallow",
            "name": "Un-shallow git",
            "when": "on_fail",
          },
        },
        {
          "run": {
            "command": "echo "Workflow failed"",
            "name": "Report failure",
            "when": "on_fail",
          },
        },
        {
          "discord/status": {
            "fail_only": true,
            "failure_message": "$(yarn get-report-message merged none)",
            "only_for_branches": "main,next,next-release,latest-release",
          },
        },
      ],
    },
