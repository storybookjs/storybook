      "name": "For Each Item",
      "snippet": "<script lang="ts" setup>
const items = [{ id: 1 }, { id: 2 }];
</script>

<template>
  <ul><li v-for="item in items" :key="item.id">{{ item === items[0] ? 'first' : 'other' }}</li></ul>
</template>",
