## Attributes

```
export type StencilPropsAttributes = {
  /** Current rating. */
  value?: number = 0;
  /** Maximum number of stars. */
  max?: number = 5;
  /** Visual variant. */
  variant?: 'compact' | 'full' = 'full';
  /** Attribute name differs from the field. */
  'aria-label-text'?: string | undefined; // property: labelText
  /** Complex prop, kept as an object. */
  labels?: Record<number, string> = {};
}
```

## Properties

```
export type StencilPropsProperties = {
  /** Internal hover state. */
  hovered?: number = -1;
}
```

## Events

```
export type StencilPropsEvents = {
  /** Emitted when the rating changes. */
  ratingChange: EventEmitter<number>;
  /** Emitted under a custom event name. */
  'stencil-reset': EventEmitter<void>;
}
```

## Methods

```
export type StencilPropsMethods = {
  /** Resets the rating to zero. */
  clear(): Promise<void>;
  render(): void;
}
```