{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "jsx": "react",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": [
    "addon-grid-overlay/src",
    "addon-grid-overlay/steps",
    "storybook/.storybook",
    "storybook/src",
    "storybook/scripts"
  ]
}
