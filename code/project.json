{
  "name": "code",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "tags": ["library"],
  "targets": {
    "fmt": {
      "executor": "nx:run-commands",
      "options": { "command": "yarn fmt:check" },
      "cache": true,
      "inputs": ["sharedGlobals", "{workspaceRoot}/**/*"],
      "configurations": { "production": {} }
    },
    "lint": {
      "dependsOn": [{ "projects": ["*"], "target": "compile" }],
      "executor": "nx:run-commands",
      "options": { "cwd": "{projectRoot}", "command": "yarn lint" },
      "cache": true,
      "inputs": ["code-all"],
      "configurations": { "production": {} }
    },
    "test": {
      "dependsOn": [{ "projects": ["*"], "target": "compile" }],
      "executor": "nx:run-commands",
      "options": { "command": "yarn test" },
      "cache": true,
      "inputs": ["code-all"],
      "configurations": { "production": {} }
    },
    "knip": {
      "dependsOn": [{ "projects": ["*"], "target": "compile" }],
      "executor": "nx:run-commands",
      "options": { "cwd": "{projectRoot}", "command": "yarn knip --no-exit-code" },
      "cache": true,
      "inputs": ["code-all"],
      "configurations": { "production": {} }
    }
  }
}
