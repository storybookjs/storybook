      "docker": [
        {
          "environment": {
            "NODE_OPTIONS": "--max_old_space_size=6144",
          },
          "image": "mcr.microsoft.com/playwright:v1.58.2-noble",
        },
      ],
      "parameters": {
        "class": {
          "default": "small",
          "description": "The Resource class",
          "enum": [
            "small",
            "medium",
            "medium+",
            "large",
            "xlarge",
          ],
          "type": "enum",
        },
      },
      "resource_class": "<<parameters.class>>",
      "working_directory": "/tmp/project",
    },
  },
  "jobs": {
    "angular-cli-latest--vite---typescript---chromatic": {
      "description": "Angular CLI Latest (Vite | TypeScript) (chromatic)",
      "executor": {
        "class": "medium",
        "name": "sb_node_22_classic",
      },
      "steps": [
        {
          "node/install": {
            "install-yarn": true,
            "node-version": "22.22.3",
          },
        },
        "checkout",
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-sandbox-angular-vite-default-ts.tar.zst | tar --extract --no-same-owner",
            "name": "Unpack sandbox from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "cp /tmp/storybook-sandboxes /tmp/project/sandbox -r --remove-destination",
            "name": "Copy sandbox to working directory",
          },
        },
        {
          "run": {
            "command": "yarn task chromatic --template angular-vite/default-ts --no-link -s chromatic",
            "environment": {
              "STORYBOOK_SANDBOX_ROOT": "./sandbox",
            },
            "name": "Running Chromatic",
          },
        },
      ],
    },
    "angular-cli-latest--vite---typescript---create": {
      "description": "Angular CLI Latest (Vite | TypeScript) (create)",
      "executor": {
        "class": "large",
        "name": "sb_node_22_browsers",
      },
      "steps": [
        {
          "node/install": {
            "install-yarn": true,
            "node-version": "22.22.3",
          },
        },
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn local-registry --open",
            "name": "Verdaccio",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn jiti ./event-log-collector.ts",
            "name": "Start Event Collector",
            "working_directory": "scripts",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6001
yarn wait-on tcp:127.0.0.1:6002
yarn wait-on tcp:127.0.0.1:6007",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "sudo corepack enable
which yarn
yarn --version",
            "name": "Setup Corepack",
          },
        },
        {
          "run": {
            "command": "yarn task sandbox --template angular-vite/default-ts --no-link -s sandbox --debug",
            "environment": {
              "STORYBOOK_CLI_SKIP_PLAYWRIGHT_INSTALLATION": 1,
              "STORYBOOK_TELEMETRY_DEBUG": 1,
              "STORYBOOK_TELEMETRY_URL": "http://127.0.0.1:6007/event-log",
            },
            "name": "Create Sandbox",
          },
        },
        {
          "run": {
            "command": "yarn task build --template angular-vite/default-ts --no-link -s build",
            "name": "Build storybook",
          },
        },
        {
          "store_artifacts": {
            "destination": "logs",
            "path": "/tmp/storybook-sandboxes/angular-vite-default-ts/debug-storybook.log",
          },
        },
        {
          "run": {
            "command": "node --version
tar --create --format=posix --pax-option=delete=atime,delete=ctime storybook-sandboxes/angular-vite-default-ts | node project/scripts/ci/zstd-stream.mjs compress 3 > workspace-sandbox-angular-vite-default-ts.tar.zst
ls -la workspace-sandbox-angular-vite-default-ts.tar.zst",
            "name": "Pack sandbox for workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "persist_to_workspace": {
            "paths": [
              "workspace-sandbox-angular-vite-default-ts.tar.zst",
            ],
            "root": "/tmp",
          },
        },
      ],
    },
    "angular-cli-latest--vite---typescript---dev": {
      "description": "Angular CLI Latest (Vite | TypeScript) (dev)",
      "executor": {
        "class": "xlarge",
