{
  "ArgsDefaultRender": "<lit-events .value=${"default event"} @my-change=${() => {}} @my-close=${() => {}}></lit-events>",
  "DomNode": "const el = document.createElement('lit-events');
el.setAttribute('value', String("changed"));
el.addEventListener('my-change', (() => {}) as EventListener);
el.addEventListener('my-close', (() => {}) as EventListener);
return el;",
  "LitTemplate": "<lit-events
  value="changed"
  @my-change=${args['my-change-event']}
  @my-close=${args['my-close-event']}
></lit-events>",
}