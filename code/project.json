{
  "name": "code",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "tags": ["library"],
  "targets": {
    "fmt": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run fmt:check" },
      "cache": true,
      "inputs": ["sharedGlobals", "{workspaceRoot}/**/*"],
      "configurations": { "production": {} }
    },
    "lint": {
      "dependsOn": [{ "projects": ["*"], "target": "compile" }],
      "executor": "nx:run-commands",
      "options": { "cwd": "{projectRoot}", "command": "pnpm run lint" },
      "cache": true,
      "inputs": ["default"],
      "configurations": { "production": {} }
    },
    "test": {
      "dependsOn": [{ "projects": ["*"], "target": "compile" }],
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test" },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/vitest.config.ts"],
      "configurations": { "production": {} }
    },
    "knip": {
      "dependsOn": [{ "projects": ["*"], "target": "compile" }],
      "executor": "nx:run-commands",
      "options": { "cwd": "{projectRoot}", "command": "pnpm run knip --no-exit-code" },
      "cache": true,
      "inputs": ["default"],
      "configurations": { "production": {} }
    }
  }
}
