    "webcomponentsstorydocs-lit-template-shapes--member-path": {
      "id": "webcomponentsstorydocs-lit-template-shapes--member-path",
      "name": "Member Path",
      "snippet": "const MemberPath = () => {
  const user = { name: 'Bob', admin: false } as { name: string; admin: boolean };
  return html`<lit-template-shapes label=${user.name}
    >${user.admin ? 'admin' : 'guest'}</lit-template-shapes
  >`;
};",
      "template": "const MemberPath = () => {
  const user = ⟦code user⟫{ name: 'Bob', admin: false }⟧ as { name: string; admin: boolean };
  return html`<lit-template-shapes label=${user.name}
    >${user.admin ? 'admin' : 'guest'}</lit-template-shapes
  >`;
};",
    },
