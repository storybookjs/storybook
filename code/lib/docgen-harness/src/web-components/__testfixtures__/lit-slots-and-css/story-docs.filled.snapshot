{
  "ArgsDefaultRender": "<style>
  lit-slots-and-css::part(panel) { color: rebeccapurple; & <changed> }
</style>
<lit-slots-and-css heading="Default render &amp; &lt;changed>" style="--slot-panel-color: teal &amp; &lt;changed>;">
  Body <b>text</b> & <changed>
  <span slot="actions"><button>Confirm</button> & <changed></span>
</lit-slots-and-css>",
  "DomNode": "const DomNode = () => {
  const el = document.createElement('lit-slots-and-css');
  el.setAttribute('heading', String('Projected & <changed>'));
  const body = document.createElement('p');
  body.textContent = 'Default slot content';
  const action = document.createElement('button');
  action.slot = 'actions';
  action.textContent = 'Confirm';
  el.append(body, action);
  return el;
};",
  "LitTemplate": "html`<lit-slots-and-css heading=${'Projected & <changed>'}>
  <p>Default slot content</p>
  <button slot="actions">Confirm</button>
</lit-slots-and-css>`",
}