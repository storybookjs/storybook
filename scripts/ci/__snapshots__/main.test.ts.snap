yarn wait-on tcp:127.0.0.1:6007",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "sudo corepack enable
which yarn
yarn --version",
            "name": "Setup Corepack",
          },
        },
        {
          "run": {
            "command": "yarn task sandbox --template lit-vite/default-ts --no-link -s sandbox --debug",
            "environment": {
              "STORYBOOK_CLI_SKIP_PLAYWRIGHT_INSTALLATION": 1,
              "STORYBOOK_TELEMETRY_DEBUG": 1,
              "STORYBOOK_TELEMETRY_URL": "http://127.0.0.1:6007/event-log",
            },
            "name": "Create Sandbox",
          },
        },
        {
          "run": {
            "command": "yarn task build --template lit-vite/default-ts --no-link -s build",
            "name": "Build storybook",
          },
        },
        {
          "store_artifacts": {
            "destination": "logs",
            "path": "/tmp/storybook-sandboxes/lit-vite-default-ts/debug-storybook.log",
          },
        },
        {
          "run": {
            "command": "node --version
tar --create --format=posix --pax-option=delete=atime,delete=ctime storybook-sandboxes/lit-vite-default-ts | node project/scripts/ci/zstd-stream.mjs compress 3 > workspace-sandbox-lit-vite-default-ts.tar.zst
ls -la workspace-sandbox-lit-vite-default-ts.tar.zst",
            "name": "Pack sandbox for workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "persist_to_workspace": {
            "paths": [
              "workspace-sandbox-lit-vite-default-ts.tar.zst",
            ],
            "root": "/tmp",
          },
        },
      ],
    },
    "lit-latest--vite---typescript---dev": {
      "description": "Lit Latest (Vite | TypeScript) (dev)",
      "executor": {
        "class": "large",
        "name": "sb_playwright",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-sandbox-lit-vite-default-ts.tar.zst | tar --extract --no-same-owner",
            "name": "Unpack sandbox from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn task dev --template lit-vite/default-ts --no-link -s dev",
            "name": "Run storybook",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6006",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "TEST_FILES=$(circleci tests glob "code/e2e-sandbox/*.{test,spec}.{ts,js,mjs}")
echo "$TEST_FILES" | circleci tests run --command="xargs yarn task e2e-tests-dev --template lit-vite/default-ts --no-link -s e2e-tests-dev --junit" --verbose --index=0 --total=1",
            "environment": {
              "PLAYWRIGHT_WORKERS": "3",
            },
            "name": "Running E2E Tests",
          },
        },
        {
          "store_artifacts": {
            "destination": "test-results",
            "path": "/tmp/project/test-results",
          },
        },
        {
          "store_artifacts": {
            "destination": "playwright-results",
            "path": "/tmp/project/code/playwright-results",
          },
        },
        {
          "store_test_results": {
            "path": "/tmp/project/test-results",
          },
        },
      ],
    },
