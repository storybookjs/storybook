{
  "ArgsDefaultRender": "<lit-property-only label="Default render" .items=${[{ name: "Alpha" }, { name: "Beta" }]} .config=${{ dense: true, theme: "dark" }}></lit-property-only>",
  "DomNode": "const el = document.createElement('lit-property-only') as HTMLElement & {
  config?: unknown;
  items?: unknown;
};
