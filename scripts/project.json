{
  "name": "scripts",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "tags": ["library"],
  "includedScripts": [],
  "targets": {
    "check": {
      "dependsOn": [],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "yarn check"
      },
      "inputs": ["default", "code-all"],
      "cache": true
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{projectRoot}",
        "command": "yarn lint"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.oxlintrc.json", "{workspaceRoot}/yarn.lock"],
      "configurations": {
        "production": {}
      }
    },
    "dedupe-check": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "{workspaceRoot}",
        "command": "yarn dedupe --check"
      },
      "inputs": [
        "{workspaceRoot}/yarn.lock",
        "{workspaceRoot}/.yarnrc.yml",
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/**/package.json"
      ],
      "cache": true
    },
    "run-registry": {},
    "publish": {},
    "bench-packages": {
      "dependsOn": [
        {
          "projects": ["*"],
          "target": "compile"
        },
        "run-registry"
      ],
      "executor": "nx:run-commands",
      "options": {
        "command": "yarn exec jiti ./scripts/ci/nx/bench-packages.ts",
        "env": {
          "BENCH_PACKAGES_CONCURRENCY": "6"
        }
      },
      "cache": false,
      "configurations": {
        "production": {}
      },
      "inputs": ["all-production"]
    }
  }
}
