            "destination": "logs",
            "path": "/tmp/storybook-sandboxes/react-vite-default-ts/debug-storybook.log",
          },
        },
        {
          "run": {
            "command": "node --version
tar --create --format=posix --pax-option=delete=atime,delete=ctime storybook-sandboxes/react-vite-default-ts | node project/scripts/ci/zstd-stream.mjs compress 3 > workspace-sandbox-react-vite-default-ts.tar.zst
ls -la workspace-sandbox-react-vite-default-ts.tar.zst",
            "name": "Pack sandbox for workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "persist_to_workspace": {
            "paths": [
              "workspace-sandbox-react-vite-default-ts.tar.zst",
            ],
            "root": "/tmp",
          },
        },
      ],
    },
