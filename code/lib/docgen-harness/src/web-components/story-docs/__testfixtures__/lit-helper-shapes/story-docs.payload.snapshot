{
  "id": "webcomponentsstorydocs-lit-helper-shapes",
  "name": "lit-template-shapes",
  "path": "__PATH__",
  "stories": {
    "webcomponentsstorydocs-lit-helper-shapes--branching-helper": {
      "id": "webcomponentsstorydocs-lit-helper-shapes--branching-helper",
      "name": "Branching Helper",
      "snippet": "if (true) {
  return html`<lit-template-shapes disabled></lit-template-shapes>`;
}
return html`<lit-template-shapes label="Alpha" count="1" disabled
  ></lit-template-shapes
>`;",
      "template": "if (⟦value disabled⟧) {
  return html`<lit-template-shapes disabled></lit-template-shapes>`;
}
return html`<lit-template-shapes ⟦attr label label ?label%3D%22Untitled%22⟧ ⟦attr count count ?count%3D%221%22⟧ ⟦bool disabled disabled⟧ ⟦prop heading heading⟧
  ></lit-template-shapes
>`;",
    },
    "webcomponentsstorydocs-lit-helper-shapes--csf-2-helper": {
      "id": "webcomponentsstorydocs-lit-helper-shapes--csf-2-helper",
      "name": "Csf 2 Helper",
      "snippet": "<lit-template-shapes label="Alpha" count="1" disabled
  ></lit-template-shapes
>",
      "template": "<lit-template-shapes ⟦attr label label ?label%3D%22Untitled%22⟧ ⟦attr count count ?count%3D%221%22⟧ disabled ⟦prop heading heading⟧
  ></lit-template-shapes
>",
    },
    "webcomponentsstorydocs-lit-helper-shapes--helper-call": {
      "id": "webcomponentsstorydocs-lit-helper-shapes--helper-call",
      "name": "Helper Call",
      "snippet": "<lit-template-shapes label="Alpha" count="2"
  ></lit-template-shapes
>",
      "template": "<lit-template-shapes ⟦attr label label ?label%3D%22Untitled%22⟧ ⟦attr count count ?count%3D%221%22⟧ ⟦bool disabled disabled⟧ ⟦prop heading heading⟧
  ></lit-template-shapes
>",
    },
    "webcomponentsstorydocs-lit-helper-shapes--helper-defaults": {
      "id": "webcomponentsstorydocs-lit-helper-shapes--helper-defaults",
      "name": "Helper Defaults",
      "snippet": "<lit-template-shapes label="Untitled" count="5" .heading=${"Head"}
  ><b>Head</b></lit-template-shapes
>",
      "template": "<lit-template-shapes ⟦attr label label ?label%3D%22Untitled%22⟧ count="5" ⟦bool disabled disabled⟧ ⟦prop heading heading⟧
  ><b>⟦text heading⟧</b></lit-template-shapes
>",
    },
    "webcomponentsstorydocs-lit-helper-shapes--helper-in-html": {
      "id": "webcomponentsstorydocs-lit-helper-shapes--helper-in-html",
      "name": "Helper In Html",
      "snippet": "<section><ul>
  <li>Alpha: 2</li><li>Fixed: 2</li>
</ul></section>",
      "template": "<section><ul>
  <li>⟦text label⟧: ⟦text count⟧</li><li>Fixed: ⟦text count⟧</li>
</ul></section>",
    },
    "webcomponentsstorydocs-lit-helper-shapes--re-exported-html": {
      "id": "webcomponentsstorydocs-lit-helper-shapes--re-exported-html",
      "name": "Re Exported Html",
      "snippet": "<lit-template-shapes label="Alpha"></lit-template-shapes>",
      "template": "<lit-template-shapes ⟦attr label label⟧></lit-template-shapes>",
    },
    "webcomponentsstorydocs-lit-helper-shapes--spread-directive": {
      "id": "webcomponentsstorydocs-lit-helper-shapes--spread-directive",
      "name": "Spread Directive",
      "snippet": "<lit-template-shapes label="Alpha" count="2" disabled></lit-template-shapes>",
      "template": "<lit-template-shapes ⟦props label=label count=count disabled=disabled .items=items heading=heading open=open⟧></lit-template-shapes>",
    },
    "webcomponentsstorydocs-lit-helper-shapes--spread-next-to-attribute": {
      "id": "webcomponentsstorydocs-lit-helper-shapes--spread-next-to-attribute",
      "name": "Spread Next To Attribute",
      "snippet": "<lit-template-shapes label="Written" count="2"
  ></lit-template-shapes
>",
      "template": "<lit-template-shapes label="Written" ⟦props count=count .items=items ^label disabled=disabled open=open⟧
  >⟦text heading⟧</lit-template-shapes
>",
    },
  },
}