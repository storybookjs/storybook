    "./internal/deep/ui/utils/trySelectStory": {
      "types": "./dist/ui/utils/trySelectStory.d.ts",
      "code": "./src/ui/utils/trySelectStory.ts",
      "default": "./dist/ui/utils/trySelectStory.js"
