    "tanstack-react-start-latest--vite---typescript---create": {
      "description": "TanStack React Start Latest (Vite | TypeScript) (create)",
      "executor": {
        "class": "large",
        "name": "sb_node_22_browsers",
      },
      "steps": [
        {
          "git-shallow-clone/checkout_advanced": {
            "clone_options": "--depth 1",
          },
        },
        {
          "attach_workspace": {
            "at": "/tmp",
          },
        },
        {
          "run": {
            "command": "node --version
node project/scripts/ci/zstd-stream.mjs decompress < workspace-node_modules.tar.zst | tar --extract",
            "name": "Unpack node_modules from workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn local-registry --open",
            "name": "Verdaccio",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "background": true,
            "command": "yarn jiti ./event-log-collector.ts",
            "name": "Start Event Collector",
            "working_directory": "scripts",
          },
        },
        {
          "run": {
            "command": "yarn wait-on tcp:127.0.0.1:6001
yarn wait-on tcp:127.0.0.1:6002
yarn wait-on tcp:127.0.0.1:6007",
            "name": "Wait on servers",
            "working_directory": "code",
          },
        },
        {
          "run": {
            "command": "sudo corepack enable
which yarn
yarn --version",
            "name": "Setup Corepack",
          },
        },
        {
          "run": {
            "command": "yarn task sandbox --template tanstack-react-start/default-ts --no-link -s sandbox --debug",
            "environment": {
              "STORYBOOK_CLI_SKIP_PLAYWRIGHT_INSTALLATION": 1,
              "STORYBOOK_TELEMETRY_DEBUG": 1,
              "STORYBOOK_TELEMETRY_URL": "http://127.0.0.1:6007/event-log",
            },
            "name": "Create Sandbox",
          },
        },
        {
          "run": {
            "command": "yarn task build --template tanstack-react-start/default-ts --no-link -s build",
            "name": "Build storybook",
          },
        },
        {
          "store_artifacts": {
            "destination": "logs",
            "path": "/tmp/storybook-sandboxes/tanstack-react-start-default-ts/debug-storybook.log",
          },
        },
        {
          "run": {
            "command": "node --version
tar --create --format=posix --pax-option=delete=atime,delete=ctime storybook-sandboxes/tanstack-react-start-default-ts | node project/scripts/ci/zstd-stream.mjs compress 3 > workspace-sandbox-tanstack-react-start-default-ts.tar.zst
ls -la workspace-sandbox-tanstack-react-start-default-ts.tar.zst",
            "name": "Pack sandbox for workspace",
            "working_directory": "/tmp",
          },
        },
        {
          "persist_to_workspace": {
            "paths": [
              "workspace-sandbox-tanstack-react-start-default-ts.tar.zst",
            ],
            "root": "/tmp",
          },
        },
      ],
    },
