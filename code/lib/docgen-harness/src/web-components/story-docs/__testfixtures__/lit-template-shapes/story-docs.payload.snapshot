    "webcomponentsstorydocs-lit-template-shapes--aliased": {
      "argCode": {},
      "id": "webcomponentsstorydocs-lit-template-shapes--aliased",
      "name": "Aliased",
      "snippet": "const heading = "Head";
const tag = html`<b>Aliased</b>`;
return html`<lit-template-shapes label="Aliased" count="7" .heading=${heading}
  >${tag}</lit-template-shapes
>`;",
      "template": "const heading = ⟦value heading⟧;
const tag = html`<b>⟦text label⟧</b>`;
return html`<lit-template-shapes label="⟦quoted label⟧" count="⟦quoted count⟧" .heading=${heading}
  >${tag}</lit-template-shapes
>`;",
    },
