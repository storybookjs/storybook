    "webcomponentsfixtures-lit-slots-and-css--args-default-render": {
      "id": "webcomponentsfixtures-lit-slots-and-css--args-default-render",
      "name": "Args Default Render",
      "snippet": "<style>
  lit-slots-and-css::part(panel) { color: rebeccapurple; }
</style>
<lit-slots-and-css heading="Default render" style="--slot-panel-color: teal;">
  Body <b>text</b>
  <button slot="actions">Confirm</button>
</lit-slots-and-css>",
      "template": "⟦style lit-slots-and-css ::part(panel)=panel-part⟧<lit-slots-and-css ⟦props ~heading=heading -default-slot -actions-slot -panel-part --slot-panel-color=--slot-panel-color *⟧>⟦slot default default-slot⟧⟦slot actions actions-slot⟧</lit-slots-and-css>",
    },
    "webcomponentsfixtures-lit-slots-and-css--dom-node": {
      "id": "webcomponentsfixtures-lit-slots-and-css--dom-node",
      "name": "Dom Node",
      "snippet": "const el = document.createElement('lit-slots-and-css');
el.setAttribute('heading', String("Projected"));
const body = document.createElement('p');
body.textContent = 'Default slot content';
const action = document.createElement('button');
action.slot = 'actions';
action.textContent = 'Confirm';
el.append(body, action);
return el;",
      "template": "const el = document.createElement('lit-slots-and-css');
