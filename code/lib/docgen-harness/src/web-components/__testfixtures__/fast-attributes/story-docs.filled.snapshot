{
  "ArgsDefaultRender": "<fast-attributes label="Default count &amp; &lt;changed>" size="large &amp; &lt;changed>" max-count="3" disabled></fast-attributes>
<script>
  document.querySelector('fast-attributes').items = ['a & <changed>'];
</script>",
  "DomNode": "const DomNode = () => {
  const el = document.createElement('fast-attributes');
  el.setAttribute('label', String('Count & <changed>'));
  el.setAttribute('size', String('large & <changed>'));
  if (true) {
    el.setAttribute('disabled', '');
  }
  el.setAttribute('max-count', String(6));
  (el as HTMLElement & { items: string[] }).items = ['a & <changed>'] as string[];
  return el;
};",
  "LitTemplate": "html`<fast-attributes
  label=${'Count & <changed>'}
  size=${'large & <changed>'}
  ?disabled=${true}
  max-count=${6}
  .items=${['a & <changed>']}
></fast-attributes>`",
}