{
  "id": "as-cast",
  "name": "AsCastComponent",
  "path": "__PATH__",
  "stories": {
    "storydocs-as-cast--casted": {
      "description": "Args behind an `as const` assertion.",
      "id": "storydocs-as-cast--casted",
      "name": "Casted",
      "snippet": "import { Component } from '@angular/core';
import { AsCastComponent } from './as-cast.component.ts';

@Component({
  selector: 'app-demo',
  imports: [AsCastComponent],
  template: `<sb-as-cast [label]="'Cast'" [tone]="'warn'" />`,
})
export class DemoComponent {}",
      "snippetTemplate": {
        "componentImport": "import { AsCastComponent } from './as-cast.component.ts';",
        "componentName": "AsCastComponent",
        "kind": "angular-snippet-template",
        "outputs": [],
        "standalone": true,
        "template": "<sb-as-cast
    [label]="{{label}}"
    [tone]="{{tone}}"
/>",
      },
    },
    "storydocs-as-cast--satisfied": {
      "id": "storydocs-as-cast--satisfied",
      "name": "Satisfied",
