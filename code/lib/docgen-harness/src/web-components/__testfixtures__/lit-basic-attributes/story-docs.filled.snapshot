{
  "ArgsDefaultRender": "<lit-basic-attributes .label=${"Default render"} .count=${3} .disabled=${true} .isOpen=${true}></lit-basic-attributes>",
  "DomNode": "const el = document.createElement('lit-basic-attributes');
el.setAttribute('label', String("Open panel"));
el.setAttribute('count', String(7));
if (false) {
  el.setAttribute('disabled', '');
}
if (true) {
  el.setAttribute('is-open', '');
}
return el;",
  "LitTemplate": "<lit-basic-attributes
  label="Open panel"
  count="7"
  is-open
></lit-basic-attributes>",
}