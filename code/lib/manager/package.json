    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^1.3.0",
    "react-router-dom": "6.15.0",
    "react-transition-state": "^2.3.1",
    "rolldown": "^1.1.4",
    "sirv": "^2.0.4",
    "slash": "^5.0.0",
    "store2": "^2.14.2",
    "telejson": "8.0.0",
    "ts-dedent": "^2.2.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@types/react": "^18.0.0 || ^19.0.0",
