    "webcomponentsstorydocs-csf-shapes--parts-and-css": {
      "id": "webcomponentsstorydocs-csf-shapes--parts-and-css",
      "name": "Parts And Css",
      "snippet": "<style>
  csf-shapes::part(panel) { color: red; }
  csf-shapes:state(active) { outline: 1px solid; }
</style>
<csf-shapes label="Meta" style="--csf-shapes-accent: teal;"></csf-shapes>",
